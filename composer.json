{
    "name": "gabarit/gabarit",
    "description": "Générateur de squelettes d'applications PHP en marque blanche (monodépôt).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-zip": "*",
        "symfony/console": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/process": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/twig": "^3.21",
        "laravel/prompts": "^0.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "autoload": {
        "psr-4": {
            "Gabarit\\Core\\": "packages/core/src/",
            "Gabarit\\Cli\\": "apps/cli/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gabarit\\Core\\Tests\\": "packages/core/tests/",
            "Gabarit\\Cli\\Tests\\": "apps/cli/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
