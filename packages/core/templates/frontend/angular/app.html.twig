<main class="brand-hero">
{% if logo_file %}
  <img src="/{{ logo_file }}" alt="" class="brand-logo" />
{% endif %}
  <h1>{{ brand.displayName|e('html') }}</h1>
  <p>Votre application {{ frontend_def.label|e('html') }} + Symfony {{ framework_version }} est prête.</p>
  <p>API : <strong>{% verbatim %}{{ health() }}{% endverbatim %}</strong></p>
</main>
