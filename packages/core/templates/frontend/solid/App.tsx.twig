import { createSignal, onMount } from 'solid-js'

function App() {
  const [health, setHealth] = createSignal('…')

  onMount(async () => {
    try {
      const response = await fetch('/api/health')
      const data: { status: string } = await response.json()
      setHealth(data.status)
    } catch {
      setHealth('injoignable')
    }
  })

  return (
    <main class="brand-hero">
{% if logo_file %}
      <img src="/{{ logo_file }}" alt="" class="brand-logo" />
{% endif %}
      <h1>{{ brand.displayName|e('html') }}</h1>
      <p>Votre application {{ frontend_def.label|e('html') }} + Symfony {{ framework_version }} est prête.</p>
      <p>
        API : <strong>{health()}</strong>
      </p>
    </main>
  )
}

export default App
