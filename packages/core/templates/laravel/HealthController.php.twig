<?php

declare(strict_types=1);

namespace App\Http\Controllers;

use Illuminate\Http\JsonResponse;
use Illuminate\Support\Facades\DB;

/**
 * Test de santé : utilisé par la CI et par la supervision.
 */
final class HealthController
{
    public function __invoke(): JsonResponse
    {
        try {
            DB::select('SELECT 1');
            $database = 'ok';
        } catch (\Throwable) {
            $database = 'error';
        }

        return response()->json(
            ['status' => 'ok' === $database ? 'ok' : 'degraded', 'app' => {{ brand.displayName|json }}, 'database' => $database],
            'ok' === $database ? 200 : 503,
        );
    }
}
