# {{ brand.displayName }} — image PHP {{ php_version }} (FPM). Générée par Gabarit.
FROM {{ php_image }}
{% set pg = 'pdo_pgsql' in php_extensions or 'pgsql' in php_extensions %}
{% set pecl = php_extensions|filter(e => e == 'redis') %}
{% set core = php_extensions|filter(e => e != 'redis') %}

RUN apk add --no-cache icu-libs libzip fcgi{% if pg %} libpq{% endif %} \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS icu-dev libzip-dev{% if pg %} postgresql-dev{% endif %} \
    && docker-php-ext-install -j"$(nproc)" intl zip opcache{% for ext in core %} {{ ext }}{% endfor %} \
{% if pecl|length %}
    && pecl install redis \
    && docker-php-ext-enable redis \
{% endif %}
    && apk del .build-deps

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY docker/php/app.ini $PHP_INI_DIR/conf.d/zz-app.ini
COPY docker/php/fpm.conf /usr/local/etc/php-fpm.d/zz-app.conf
# Rend inscriptibles les dossiers du framework (code monté depuis la machine hôte).
COPY docker/php/entrypoint.sh /usr/local/bin/app-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/app-entrypoint && chmod +x /usr/local/bin/app-entrypoint

WORKDIR /var/www/app
ENTRYPOINT ["app-entrypoint"]
CMD ["php-fpm"]
