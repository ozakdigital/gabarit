{% verbatim %}{% extends 'base.html.twig' %}

{% block body %}{% endverbatim %}
<main class="brand-hero">
{% if logo_file %}
    <img src="/{{ logo_file }}" alt="" class="brand-logo">
{% endif %}
    <h1>{{ brand.displayName|e('html') }}</h1>
    <p>Votre application Symfony {{ framework_version }} est prête.</p>
    <p><a class="brand-button" href="/api/health">Test de santé</a></p>
</main>
{% verbatim %}{% endblock %}{% endverbatim %}
