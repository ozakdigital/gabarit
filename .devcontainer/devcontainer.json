// Dev Container de Gabarit : VS Code s'ouvre dans le conteneur `php` (PHP 8.3, Composer, Node, make,
// client Docker). Rien d'autre que Docker n'est nécessaire sur la machine.
{
  "name": "Gabarit",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "php",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "make install && make hooks",
  "forwardPorts": [5173, 8000, 8090],
  "portsAttributes": {
    "5173": { "label": "Interface (make web-dev)" },
    "8000": { "label": "API (make web-dev)" },
    "8090": { "label": "Site (make web)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "junstyle.php-cs-fixer",
        "Vue.volar",
        "vitest.explorer",
        "redhat.vscode-yaml",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "php.validate.executablePath": "/usr/local/bin/php",
        "php-cs-fixer.executablePath": "${workspaceFolder}/vendor/bin/php-cs-fixer",
        "php-cs-fixer.config": ".php-cs-fixer.dist.php"
      }
    }
  }
}
